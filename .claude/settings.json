{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(python ops/bin/skyops.py *)",
      "Bash(python3 ops/bin/skyops.py *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh label *)",
      "Bash(gh api *)",
      "Bash(gh auth status)",
      "Bash(git *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(date *)",
      "Bash(date)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf *)",
      "Bash(gh repo delete *)",
      "Bash(gh repo edit *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run.sh\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run.sh\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/stop_check.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "sh \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run.sh\" \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre_compact.py\""
          }
        ]
      }
    ]
  }
}

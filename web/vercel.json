{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-production-02611b3c.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!bundle/|devmock/|assets/|favicon|api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/bundle/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/bundle/(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}

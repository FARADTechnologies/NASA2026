# Keep shell/python/config files LF on every OS (CRLF in run.sh breaks every hook on Windows).
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
# bundle binaries: never touch line endings
*.f32 binary
*.u8 binary
*.png binary
# append-only memory files: union-merge so parallel appends never conflict
ops/memory/KNOWHOW.md merge=union
ops/memory/DECISIONS.md merge=union
